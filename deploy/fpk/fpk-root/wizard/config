[
  {
    "stepTitle": "服务设置",
    "items": [
      {
        "type": "tips",
        "helpText": "此端口为门户对外服务端口，桌面图标与内外网访问均使用它。修改后应用将自动重启以生效。"
      },
      {
        "type": "tips",
        "helpText": "平台业务数据需要 PostgreSQL 17。连接串指向服务端可访问的数据库，连接用户需拥有创建表和索引的权限。"
      },
      {
        "type": "password",
        "field": "wizard_database_url",
        "label": "PostgreSQL 连接串（必填）",
        "rules": [
          { "required": true, "message": "请填写 PostgreSQL 连接串" },
          { "pattern": "^postgres(?:ql)?://.+$", "message": "连接串必须以 postgres:// 或 postgresql:// 开头" }
        ]
      },
      {
        "type": "text",
        "field": "wizard_port",
        "label": "服务端口",
        "initValue": "8080",
        "rules": [
          { "required": true, "message": "请填写端口" },
          { "pattern": "^[0-9]+$", "message": "仅数字" }
        ]
      }
    ]
  }
]
